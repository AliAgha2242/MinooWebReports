# Copy this file to .env and fill in real values.
# Do not commit .env or place production secrets in this file.

REPORTS_HTTP_PORT=8080

# SQL Server metadata database (ReportDefinitions / ReportParameters)
REPORTS_METADATA_CONNECTION_STRING=Server=YOUR_SQL_SERVER;Database=YOUR_REPORTS_METADATA_DB;User Id=YOUR_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Same authentication database used by MinooWebCore for standalone login
CORE_AUTH_CONNECTION_STRING=Server=YOUR_SQL_SERVER;Database=YOUR_CORE_DB;User Id=YOUR_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# SQL authentication used when connecting to report target servers
REPORTS_TARGET_SQL_USERNAME=YOUR_REPORT_READONLY_USER
REPORTS_TARGET_SQL_PASSWORD=CHANGE_ME

# Redis reachable from the Docker host/network
REDIS_CONNECTION_STRING=172.16.5.39:6379,abortConnect=false

REPORTS_COMMAND_TIMEOUT_SECONDS=60
REPORTS_MAX_ROWS=5000
REPORTS_MAX_EXCEL_BYTES=20971520

# Optional parent MinooWebCore SSO settings
SSO_PARENT_LOGIN_URL=
SSO_PARENT_LAUNCH_PATH=/Account/LaunchReports
SSO_PARENT_REDEEM_URL=
SSO_PARENT_CLIENT_SECRET=

# Optional report administrator user codes
REPORTS_ADMIN_USER_CODE_0=
REPORTS_ADMIN_USER_CODE_1=
