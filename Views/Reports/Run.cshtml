@model MinooWebReports.Models.ReportRunViewModel
@using System.Text.Json
@functions {
    private static string GetProperty(JsonElement element, params string[] names)
    {
        foreach (var property in element.EnumerateObject())
            if (names.Contains(property.Name, StringComparer.OrdinalIgnoreCase))
                return property.Value.ToString();
        return "";
    }

    private static List<(string Value, string Label)> ReadOptions(string? json)
    {
        var result = new List<(string Value, string Label)>();
        if (string.IsNullOrWhiteSpace(json)) return result;
        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in document.RootElement.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.String)
                    {
                        var value = item.GetString() ?? "";
                        result.Add((value, value));
                    }
                    else if (item.ValueKind == JsonValueKind.Object)
                    {
                        var value = GetProperty(item, "value");
                        var label = GetProperty(item, "label", "displayName", "text");
                        if (!string.IsNullOrWhiteSpace(value))
                            result.Add((value, string.IsNullOrWhiteSpace(label) ? value : label));
                    }
                }
            }
            else if (document.RootElement.ValueKind == JsonValueKind.Object)
            {
                foreach (var property in document.RootElement.EnumerateObject())
                    result.Add((property.Name, property.Value.ToString()));
            }
        }
        catch (JsonException) { }
        return result;
    }
}
@{
    ViewData["Title"] = Model.Report.Name;
}
<main class="admin-page reports-dashboard">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M<span>•</span></span><span class="brand-copy"><strong>MINOO</strong><span>WEB REPORTS</span></span></a>
        <div class="admin-sidebar-label">سامانه گزارشات</div>
        <nav class="admin-menu" aria-label="منوی اصلی">
            <a class="admin-menu-link" asp-controller="Home" asp-action="Index"><span class="admin-menu-icon">⌂</span><span>داشبورد</span></a>
            <a class="admin-menu-link active" asp-controller="Reports" asp-action="Index"><span class="admin-menu-icon">▤</span><span>گزارش‌ها</span></a>
        </nav>
    </aside>
    <section class="admin-main">
        <header class="admin-topbar"><div><span class="admin-breadcrumb">MINOO / REPORTS / PARAMETERS</span><h1>@Model.Report.Name</h1></div><a class="reports-back-link" asp-action="Index">بازگشت به گزارش‌ها</a></header>
        <section class="admin-welcome reports-welcome"><div><span class="admin-eyebrow"><span class="status-dot"></span> REPORT PARAMETERS</span><h2>تنظیم پارامترهای گزارش</h2><p>تمام مقادیر موردنیاز را در همین فرم تکمیل کنید و یک‌بار گزارش را اجرا کنید.</p></div><span class="admin-welcome-symbol">R<span>•</span></span></section>
        <section class="reports-active-strip reports-run-connection" aria-label="محل اجرای گزارش">
            <span class="reports-connection-status-dot"></span>
            <strong>محل اجرای گزارش</strong>
            @if (Model.ExecutionConnections.Count > 1)
            {
                <span>تعداد سرورها: <b>@Model.ExecutionConnections.Count</b></span>
                <span>سرورها: <bdi>@string.Join("، ", Model.ExecutionConnections.Select(item => $"{item.Server} / {item.DataBAset}"))</bdi></span>
            }
            else
            {
                <span>واحد تجاری: <b>@Model.SelectedConnection.VahedetejariDs</b></span>
                <span>سرور: <bdi>@Model.SelectedConnection.Server</bdi></span>
                <span>دیتابیس: <bdi>@Model.SelectedConnection.DataBAset</bdi></span>
            }
        </section>
        @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="report-message report-message-error" role="alert">@Model.Error</div> }
        <section class="report-builder">
            <form asp-action="Run" method="post" class="reports-run-form" id="report-parameters-form" data-report-run-form>
                <div class="reports-loading-overlay" data-report-loading hidden role="status" aria-live="assertive">
                    <div class="reports-loading-card">
                        <span class="reports-loading-spinner" aria-hidden="true"></span>
                        <strong>در حال آماده‌سازی گزارش</strong>
                        <p>در حال اتصال به پایگاه داده و پردازش اطلاعات هستیم.</p>
                        <div class="reports-loading-details">
                            @if (Model.ExecutionConnections.Count > 1)
                            {
                                <span>در حال اجرا روی <b>@Model.ExecutionConnections.Count سرور</b></span>
                                <span>سرورها <bdi>@string.Join("، ", Model.ExecutionConnections.Select(item => item.Server))</bdi></span>
                            }
                            else
                            {
                                <span>واحد تجاری <b>@Model.SelectedConnection.VahedetejariDs</b></span>
                                <span>سرور <bdi>@Model.SelectedConnection.Server</bdi></span>
                                <span>دیتابیس <bdi>@Model.SelectedConnection.DataBAset</bdi></span>
                            }
                        </div>
                        <small>لطفاً تا نمایش نتیجه، این صفحه را نبندید.</small>
                    </div>
                </div>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Report.Id" />
                <div class="report-parameters-heading">
                    <div><span class="report-step">STEP 02 · PARAMETERS</span><h3>پارامترهای ورودی</h3><p>همه پارامترهای گزارش در این بخش قرار دارند.</p></div>
                    <span class="reports-parameter-count">@Model.Report.Parameters.Count پارامتر</span>
                </div>
                @if (Model.Report.Parameters.Count == 0)
                {
                    <p class="reports-demo-hint">این گزارش پارامتر ورودی ندارد.</p>
                }
                <div class="reports-parameter-grid">
                    @foreach (var parameter in Model.Report.Parameters)
                    {
                        var currentValue = Model.Values.TryGetValue(parameter.Name, out var v) ? v : "";
                        var fieldId = $"param-{parameter.Name}";
                        var options = ReadOptions(parameter.Options);
                        var datePlaceholder = parameter.Type == "DateTime"
                            ? string.Concat(parameter.DateFormat ?? "1405/01/01", parameter.DateTimeSeparator ?? " ", parameter.TimeFormat ?? "HH:mm:ss")
                            : parameter.DateFormat ?? "1405/01/01";
                        <div class="reports-parameter-field">
                            <label for="@fieldId">@parameter.DisplayName</label>
                            @if (parameter.Type == "Checkbox")
                            {
                                <label class="reports-checkbox">
                                    <input type="hidden" name="submittedValues[@parameter.Name]" value="false" />
                                    <input id="@fieldId" type="checkbox" name="submittedValues[@parameter.Name]" value="true" checked="@(currentValue == "true")" /> فعال
                                </label>
                            }
                            else if (parameter.Type == "RadioButton")
                            {
                                <div class="reports-radio-list">
                                    @foreach (var option in options)
                                    {
                                        <label class="reports-radio-option"><input type="radio" name="submittedValues[@parameter.Name]" value="@option.Value" checked="@(currentValue == option.Value)" /> @option.Label</label>
                                    }
                                </div>
                            }
                            else if (parameter.Type == "ListBox")
                            {
                                var selectedValues = (currentValue ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                <input type="hidden" name="submittedListBoxes[@parameter.Name]" value="true" />
                                <div class="reports-searchable-listbox" data-searchable-listbox>
                                    <button type="button" class="reports-input reports-listbox-trigger"
                                            data-listbox-trigger aria-expanded="false"
                                            aria-label="انتخاب موارد برای @parameter.DisplayName">
                                        <span data-listbox-selection-label>انتخاب کنید...</span>
                                        <span class="reports-listbox-chevron" aria-hidden="true">⌄</span>
                                    </button>
                                    <div class="reports-listbox-dropdown" data-listbox-dropdown hidden>
                                    <input type="search" class="reports-input reports-listbox-search" data-listbox-search
                                           placeholder="جست‌وجو در گزینه‌ها..." aria-label="جست‌وجو در @parameter.DisplayName"
                                           autocomplete="off" />
                                    <div class="reports-listbox-options" data-listbox-options
                                         role="group" aria-label="@parameter.DisplayName"
                                         data-field-name="submittedValues[@parameter.Name]">
                                        @foreach (var option in options)
                                        {
                                            var isSelected = selectedValues.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                            <label class="reports-listbox-option" data-listbox-option
                                                   data-search-text="@($"{option.Label} {option.Value}")">
                                                <input type="checkbox" value="@option.Value" checked="@isSelected" data-listbox-checkbox />
                                                <span class="reports-listbox-option-label">@option.Label</span>
                                                <small class="reports-listbox-option-value" dir="ltr">@option.Value</small>
                                            </label>
                                        }
                                    </div>
                                    <div data-listbox-hidden-inputs>
                                        @foreach (var selectedValue in selectedValues)
                                        {
                                            <input type="hidden" name="submittedValues[@parameter.Name]" value="@selectedValue" />
                                        }
                                    </div>
                                    </div>
                                    <small class="reports-field-hint" data-listbox-status>
                                        @if (options.Count > 100)
                                        {
                                            <text>۱۰۰ گزینه اول نمایش داده می‌شود؛ برای یافتن سایر گزینه‌ها جست‌وجو کنید.</text>
                                        }
                                        else
                                        {
                                            <text>@options.Count گزینه موجود است.</text>
                                        }
                                    </small>
                                </div>
                            }
                            else if (parameter.Type == "ComboBox")
                            {
                                <select id="@fieldId" name="submittedValues[@parameter.Name]" class="reports-input">
                                    <option value="">انتخاب کنید...</option>
                                    @foreach (var option in options)
                                    {
                                        <option value="@option.Value" selected="@(currentValue == option.Value)">@option.Label</option>
                                    }
                                </select>
                            }
                            else if ((parameter.Type == "Date" || parameter.Type == "DateTime") && string.Equals(parameter.CalendarType, "Persian", StringComparison.OrdinalIgnoreCase))
                            {
                                <input id="@fieldId" name="submittedValues[@parameter.Name]" type="text" inputmode="numeric" placeholder="@datePlaceholder" value="@currentValue" class="reports-input" dir="ltr" />
                                <small class="reports-field-hint">@(parameter.Type == "DateTime" ? "تاریخ و ساعت شمسی" : "تاریخ شمسی") · فرمت @parameter.DateFormat @parameter.TimeFormat</small>
                            }
                            else
                            {
                                var inputType = parameter.Type switch
                                {
                                    "Number" => "number",
                                    "Date" => "date",
                                    "Time" => "time",
                                    "DateTime" => "datetime-local",
                                    _ => "text"
                                };
                                <input id="@fieldId" name="submittedValues[@parameter.Name]" type="@inputType" step="@(parameter.Type == "Number" ? "any" : parameter.Type == "Time" || parameter.Type == "DateTime" ? "1" : null)" value="@currentValue" class="reports-input" />
                                @if (parameter.Type == "DateTime" && !string.IsNullOrWhiteSpace(parameter.DateTimeSeparator))
                                {
                                    <small class="reports-field-hint">جداکننده تاریخ و ساعت در مقدار ارسالی: «@parameter.DateTimeSeparator»</small>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(parameter.DefaultValue))
                            {
                                <small class="reports-field-hint">مقدار پیش‌فرض: <bdi dir="auto">@parameter.DefaultValue</bdi> · در صورت خالی گذاشتن، همین مقدار استفاده می‌شود.</small>
                            }
                        </div>
                    }
                </div>
                <div class="reports-run-actions">
                    <a asp-action="Index" class="reports-clear-button">انصراف</a>
                    <button type="submit" class="reports-run-button" data-report-run-button>اجرای گزارش <span>←</span></button>
                </div>
            </form>
        </section>
        <footer class="admin-footer"><span>© @DateTime.Now.Year گروه صنعتی مینو</span><span>MINOO WEB REPORTS</span></footer>
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector("[data-report-run-form]");
            if (!form) return;

            // Capture the submit before the shared script starts navigation.
            // This guarantees the overlay is visible even when the form is submitted
            // through the normal HTML form pipeline.
            form.addEventListener("submit", () => {
                const overlay = form.querySelector("[data-report-loading]");
                if (!overlay) return;
                overlay.hidden = false;
                overlay.removeAttribute("hidden");
            }, true);

            // Fallback initializer for the searchable ListBox in case the shared
            // site script is unavailable or fails before binding its handlers.
            document.querySelectorAll("[data-searchable-listbox]").forEach(container => {
                if (container.dataset.listboxInitialized === "true") return;

                const trigger = container.querySelector("[data-listbox-trigger]");
                const dropdown = container.querySelector("[data-listbox-dropdown]");
                const search = container.querySelector("[data-listbox-search]");
                const list = container.querySelector("[data-listbox-options]");
                const hiddenInputs = container.querySelector("[data-listbox-hidden-inputs]");
                const selectionLabel = container.querySelector("[data-listbox-selection-label]");
                const status = container.querySelector("[data-listbox-status]");
                if (!trigger || !dropdown || !search || !list || !hiddenInputs) return;

                const items = Array.from(list.querySelectorAll("[data-listbox-option]"));
                const selectedItems = () => items.filter(item => item.querySelector("[data-listbox-checkbox]")?.checked);
                const render = () => {
                    const query = search.value.trim().toLocaleLowerCase();
                    const matches = items.filter(item => (item.dataset.searchText || "").toLocaleLowerCase().includes(query));
                    const visible = new Set(matches.slice(0, 100));
                    items.forEach(item => {
                        const checkbox = item.querySelector("[data-listbox-checkbox]");
                        item.hidden = !visible.has(item) && !checkbox?.checked;
                    });
                    if (status) status.textContent = `${matches.length} گزینه پیدا شد · ${selectedItems().length} انتخاب‌شده`;
                };
                const sync = () => {
                    hiddenInputs.replaceChildren();
                    selectedItems().forEach(item => {
                        const checkbox = item.querySelector("[data-listbox-checkbox]");
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = list.dataset.fieldName;
                        input.value = checkbox.value;
                        hiddenInputs.appendChild(input);
                    });
                    if (selectionLabel) selectionLabel.textContent = selectedItems().length
                        ? `${selectedItems().length} مورد انتخاب شده`
                        : "انتخاب کنید...";
                };
                const close = () => {
                    dropdown.hidden = true;
                    trigger.setAttribute("aria-expanded", "false");
                    container.classList.remove("is-open");
                };
                trigger.addEventListener("click", event => {
                    event.preventDefault();
                    const shouldOpen = dropdown.hidden;
                    dropdown.hidden = !shouldOpen;
                    trigger.setAttribute("aria-expanded", String(shouldOpen));
                    container.classList.toggle("is-open", shouldOpen);
                    if (shouldOpen) {
                        render();
                        search.focus();
                    }
                });
                list.addEventListener("change", event => {
                    if (!event.target.matches("[data-listbox-checkbox]")) return;
                    sync();
                    render();
                });
                search.addEventListener("input", render);
                search.addEventListener("keydown", event => {
                    if (event.key === "Escape") {
                        close();
                        trigger.focus();
                    }
                });
                document.addEventListener("pointerdown", event => {
                    if (!container.contains(event.target)) close();
                });
                container.dataset.listboxInitialized = "true";
                sync();
                render();
                close();
            });
        })();
    </script>
}
