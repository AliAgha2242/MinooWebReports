@model MinooWebReports.Models.ReportRunViewModel
@using System.Text.Json
@functions {
    private static string GetProperty(JsonElement element, params string[] names)
    {
        foreach (var property in element.EnumerateObject())
            if (names.Contains(property.Name, StringComparer.OrdinalIgnoreCase))
                return property.Value.ToString();
        return "";
    }

    private static List<(string Value, string Label)> ReadOptions(string? json)
    {
        var result = new List<(string Value, string Label)>();
        if (string.IsNullOrWhiteSpace(json)) return result;
        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in document.RootElement.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.String)
                    {
                        var value = item.GetString() ?? "";
                        result.Add((value, value));
                    }
                    else if (item.ValueKind == JsonValueKind.Object)
                    {
                        var value = GetProperty(item, "value");
                        var label = GetProperty(item, "label", "displayName", "text");
                        if (!string.IsNullOrWhiteSpace(value))
                            result.Add((value, string.IsNullOrWhiteSpace(label) ? value : label));
                    }
                }
            }
            else if (document.RootElement.ValueKind == JsonValueKind.Object)
            {
                foreach (var property in document.RootElement.EnumerateObject())
                    result.Add((property.Name, property.Value.ToString()));
            }
        }
        catch (JsonException) { }
        return result;
    }
}
@{
    ViewData["Title"] = Model.Report.Name;
}
<main class="admin-page reports-dashboard">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M<span>•</span></span><span class="brand-copy"><strong>MINOO</strong><span>WEB REPORTS</span></span></a>
        <div class="admin-sidebar-label">سامانه گزارشات</div>
        <nav class="admin-menu" aria-label="منوی اصلی">
            <a class="admin-menu-link" asp-controller="Home" asp-action="Index"><span class="admin-menu-icon">⌂</span><span>داشبورد</span></a>
            <a class="admin-menu-link active" asp-controller="Reports" asp-action="Index"><span class="admin-menu-icon">▤</span><span>گزارش‌ها</span></a>
        </nav>
    </aside>
    <section class="admin-main">
        <header class="admin-topbar"><div><span class="admin-breadcrumb">MINOO / REPORTS / PARAMETERS</span><h1>@Model.Report.Name</h1></div><a class="reports-back-link" asp-action="Index">بازگشت به گزارش‌ها</a></header>
        <section class="admin-welcome reports-welcome"><div><span class="admin-eyebrow"><span class="status-dot"></span> REPORT PARAMETERS</span><h2>تنظیم پارامترهای گزارش</h2><p>تمام مقادیر موردنیاز را در همین فرم تکمیل کنید و یک‌بار گزارش را اجرا کنید.</p></div><span class="admin-welcome-symbol">R<span>•</span></span></section>
        @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="report-message report-message-error" role="alert">@Model.Error</div> }
        <section class="report-builder">
            <form asp-action="Run" method="post" class="reports-run-form" id="report-parameters-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Report.Id" />
                <div class="report-parameters-heading">
                    <div><span class="report-step">STEP 02 · PARAMETERS</span><h3>پارامترهای ورودی</h3><p>همه پارامترهای گزارش در این بخش قرار دارند.</p></div>
                    <span class="reports-parameter-count">@Model.Report.Parameters.Count پارامتر</span>
                </div>
                @if (Model.Report.Parameters.Count == 0)
                {
                    <p class="reports-demo-hint">این گزارش پارامتر ورودی ندارد.</p>
                }
                <div class="reports-parameter-grid">
                    @foreach (var parameter in Model.Report.Parameters)
                    {
                        var currentValue = Model.Values.TryGetValue(parameter.Name, out var v) ? v : "";
                        var fieldId = $"param-{parameter.Name}";
                        var options = ReadOptions(parameter.Options);
                        var datePlaceholder = parameter.Type == "DateTime"
                            ? string.Concat(parameter.DateFormat ?? "1405/01/01", parameter.DateTimeSeparator ?? " ", parameter.TimeFormat ?? "HH:mm:ss")
                            : parameter.DateFormat ?? "1405/01/01";
                        <div class="reports-parameter-field">
                            <label for="@fieldId">@parameter.DisplayName</label>
                            @if (parameter.Type == "Checkbox")
                            {
                                <label class="reports-checkbox"><input id="@fieldId" type="checkbox" name="submittedValues[@parameter.Name]" value="true" checked="@(currentValue == "true")" /> فعال</label>
                            }
                            else if (parameter.Type == "RadioButton")
                            {
                                <div class="reports-radio-list">
                                    @foreach (var option in options)
                                    {
                                        <label class="reports-radio-option"><input type="radio" name="submittedValues[@parameter.Name]" value="@option.Value" checked="@(currentValue == option.Value)" /> @option.Label</label>
                                    }
                                </div>
                            }
                            else if (parameter.Type == "ListBox")
                            {
                                var selectedValues = (currentValue ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                <select id="@fieldId" name="submittedValues[@parameter.Name]" class="reports-input" multiple size="5" aria-label="@parameter.DisplayName">
                                    @foreach (var option in options)
                                    {
                                        <option value="@option.Value" selected="@selectedValues.Contains(option.Value, StringComparer.OrdinalIgnoreCase)">@option.Label</option>
                                    }
                                </select>
                                <small class="reports-field-hint">برای انتخاب چند مورد، کلید Ctrl را نگه دارید.</small>
                            }
                            else if (parameter.Type == "ComboBox")
                            {
                                <select id="@fieldId" name="submittedValues[@parameter.Name]" class="reports-input">
                                    <option value="">انتخاب کنید...</option>
                                    @foreach (var option in options)
                                    {
                                        <option value="@option.Value" selected="@(currentValue == option.Value)">@option.Label</option>
                                    }
                                </select>
                            }
                            else if ((parameter.Type == "Date" || parameter.Type == "DateTime") && string.Equals(parameter.CalendarType, "Persian", StringComparison.OrdinalIgnoreCase))
                            {
                                <input id="@fieldId" name="submittedValues[@parameter.Name]" type="text" inputmode="numeric" placeholder="@datePlaceholder" value="@currentValue" class="reports-input" dir="ltr" />
                                <small class="reports-field-hint">@(parameter.Type == "DateTime" ? "تاریخ و ساعت شمسی" : "تاریخ شمسی") · فرمت @parameter.DateFormat @parameter.TimeFormat</small>
                            }
                            else
                            {
                                var inputType = parameter.Type switch
                                {
                                    "Number" => "number",
                                    "Date" => "date",
                                    "Time" => "time",
                                    "DateTime" => "datetime-local",
                                    _ => "text"
                                };
                                <input id="@fieldId" name="submittedValues[@parameter.Name]" type="@inputType" step="@(parameter.Type == "Number" ? "any" : parameter.Type == "Time" || parameter.Type == "DateTime" ? "1" : null)" value="@currentValue" class="reports-input" />
                                @if (parameter.Type == "DateTime" && !string.IsNullOrWhiteSpace(parameter.DateTimeSeparator))
                                {
                                    <small class="reports-field-hint">جداکننده تاریخ و ساعت در مقدار ارسالی: «@parameter.DateTimeSeparator»</small>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="reports-run-actions">
                    <a asp-action="Index" class="reports-clear-button">انصراف</a>
                    <button type="submit" class="reports-run-button">اجرای گزارش <span>←</span></button>
                </div>
            </form>
        </section>
        <footer class="admin-footer"><span>© @DateTime.Now.Year گروه صنعتی مینو</span><span>MINOO WEB REPORTS</span></footer>
    </section>
</main>
