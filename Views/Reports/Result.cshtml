@model MinooWebReports.Models.ReportResultViewModel
@{
    ViewData["Title"] = "نتیجه " + Model.Report.Name;
    var visibleColumns = Model.AllColumns.Where(column => !Model.HiddenColumns.Contains(column, StringComparer.OrdinalIgnoreCase)).ToList();
}
@functions {
    private static string DisplayCell(System.Data.DataRow row, string column) =>
        row[column] is DBNull
            ? "—"
            : Convert.ToString(row[column], System.Globalization.CultureInfo.CurrentCulture) ?? "—";
}
<main class="reports-result-page" data-report-grid data-report-id="@Model.Report.Id" data-grid-user="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "browser")" data-grid-theme="@Model.GridTheme">
    <header class="reports-result-header">
        <a class="admin-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M<span>•</span></span><span class="brand-copy"><strong>MINOO</strong><span>WEB REPORTS</span></span></a>
        <div class="reports-result-header-title">
            <span class="admin-breadcrumb">MINOO / REPORTS / RESULT</span>
            <h1>@Model.Report.Name</h1>
            <p>گزارش تعاملی · فیلتر، گروه‌بندی و شخصی‌سازی ستون‌ها</p>
        </div>
        <a class="reports-back-link" asp-action="Run" asp-route-id="@Model.Report.Id">بازگشت به پارامترها</a>
    </header>

    <form asp-action="Run" method="post" class="reports-result-workspace" data-report-grid-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Report.Id" />
        <input type="hidden" name="hiddenColumnsSubmitted" value="true" />
        <input type="hidden" name="groupColumnsSubmitted" value="true" />
        <input type="hidden" name="columnWidthsJson" value="@System.Text.Json.JsonSerializer.Serialize(Model.ColumnWidths)" data-column-widths />
        <input type="hidden" name="gridTheme" value="@Model.GridTheme" data-grid-theme-input />
        @foreach (var item in Model.Values)
        {
            <input type="hidden" name="submittedValues[@item.Key]" value="@item.Value" />
        }

        <div class="reports-grid-toolbar">
            <div>
                <span class="report-step">REPORT OUTPUT</span>
                <h2> @Model.Report.Name </h2>
                <p>@Model.TotalRows.ToString("N0") رکورد · صفحه @Model.Page از @Model.TotalPages</p>
            </div>
            <div class="reports-grid-actions">
                <label class="reports-theme-picker">قالب نمایش
                    <select class="reports-input" data-grid-theme-picker aria-label="انتخاب تم گزارش">
                        <option value="midnight" selected="@(Model.GridTheme == "midnight")">نیمه‌شب</option>
                        <option value="light" selected="@(Model.GridTheme == "light")">روشن</option>
                        <option value="ocean" selected="@(Model.GridTheme == "ocean")">اقیانوسی</option>
                        <option value="contrast" selected="@(Model.GridTheme == "contrast")">کنتراست بالا</option>
                    </select>
                </label>
                @if (Model.Report.NeedsPagination)
                {
                    <label>تعداد در صفحه
                        <select name="pageSize" class="reports-input reports-page-size">
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                            <option value="200" selected="@(Model.PageSize == 200)">200</option>
                        </select>
                    </label>
                }
            </div>
        </div>

        <details class="reports-grouping-panel" aria-label="گروه‌بندی ستون‌ها">
            <summary class="reports-grouping-summary">
                <span class="reports-grouping-summary-title"><strong>گروه‌بندی</strong><small>برای انتخاب و مرتب‌سازی ستون‌های گروه‌بندی باز کنید</small></span>
                <span class="reports-grouping-summary-meta">حداکثر ۳ سطح <span class="reports-collapse-icon">⌄</span></span>
            </summary>
            <div class="reports-grouping-content">
            <div class="reports-group-dropzone" data-group-dropzone>
                <span class="reports-group-placeholder" data-group-placeholder>ستون‌ها را از فهرست زیر به این قسمت بکشید</span>
                @foreach (var column in Model.GroupColumns)
                {
                    <span class="reports-group-chip" draggable="true" data-group-chip data-column="@column">
                        <span class="reports-drag-handle">⠿</span><b>@column</b>
                        <button type="button" data-remove-group aria-label="حذف گروه @column">×</button>
                        <input type="hidden" name="groupColumns" value="@column" />
                    </span>
                }
            </div>
            <div class="reports-group-palette" data-group-palette>
                @foreach (var column in Model.AllColumns.Where(column => !Model.GroupColumns.Contains(column, StringComparer.OrdinalIgnoreCase)))
                {
                    <button type="button" class="reports-group-source" draggable="true" data-group-source data-column="@column">@column <span>⠿</span></button>
                }
            </div>
            </div>
        </details>

        <input type="hidden" name="sortColumn" value="@Model.SortColumn" data-sort-column-input />
        <input type="hidden" name="sortDescending" value="@Model.SortDescending.ToString().ToLowerInvariant()" data-sort-direction-input />
        <div class="reports-grid-controls">
            <details class="reports-column-picker">
                <summary><span class="reports-column-picker-title">ستون‌ها</span><span class="reports-column-picker-count">@Model.HiddenColumns.Count پنهان</span></summary>
                <div class="reports-column-picker-list">
                    @foreach (var column in Model.AllColumns)
                    {
                        <label><input type="checkbox" name="hiddenColumns" value="@column" checked="@Model.HiddenColumns.Contains(column, StringComparer.OrdinalIgnoreCase)" /> @column</label>
                    }
                </div>
            </details>
            <button type="submit" class="reports-run-button">اعمال فیلتر و گروه‌بندی <span>↻</span></button>
        </div>

        <div class="reports-table-wrap reports-result-table-wrap">
            <table class="reports-data-table" data-report-table>
                <thead>
                    <tr class="reports-table-heading-row">
                        @foreach (var column in visibleColumns)
                        {
                            var width = Model.ColumnWidths.TryGetValue(column, out var savedWidth) ? savedWidth : 160;
                            <th data-column-header="@column" style="width:@(width)px;min-width:90px">
                                <div class="reports-th-title">
                                    <span class="reports-th-label">@column</span>
                                    <span class="reports-sort-arrows" role="group" aria-label="مرتب‌سازی @column">
                                        <button type="button" class="reports-sort-arrow @(Model.SortColumn == column && !Model.SortDescending ? "is-active" : "")" data-sort-column="@column" data-sort-direction="asc" aria-label="مرتب‌سازی صعودی @column" aria-pressed="@(Model.SortColumn == column && !Model.SortDescending ? "true" : "false")">↑</button>
                                        <button type="button" class="reports-sort-arrow @(Model.SortColumn == column && Model.SortDescending ? "is-active" : "")" data-sort-column="@column" data-sort-direction="desc" aria-label="مرتب‌سازی نزولی @column" aria-pressed="@(Model.SortColumn == column && Model.SortDescending ? "true" : "false")">↓</button>
                                    </span>
                                    <span class="reports-resize-handle" data-column-resizer aria-hidden="true"></span>
                                </div>
                            </th>
                        }
                    </tr>
                    <tr class="reports-filter-row">
                        @foreach (var column in visibleColumns)
                        {
                            <th>
                                <input class="reports-column-filter" name="filters[@column]" value="@(Model.Filters.TryGetValue(column, out var filter) ? filter : "")" placeholder="فیلتر @column" aria-label="فیلتر ستون @column" />
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (Model.Result.Rows.Count == 0)
                {
                    <tr><td colspan="@Math.Max(1, visibleColumns.Count)">داده‌ای برای نمایش وجود ندارد.</td></tr>
                }
                else
                {
                    var previousGroupValues = new object?[Model.GroupColumns.Count];
                    var hasPreviousGroupValues = new bool[Model.GroupColumns.Count];
                    @foreach (System.Data.DataRow row in Model.Result.Rows)
                    {
                        @for (var level = 0; level < Model.GroupColumns.Count; level++)
                        {
                            var groupColumn = Model.GroupColumns[level];
                            var currentGroupValue = row[groupColumn];
                            if (!hasPreviousGroupValues[level] || !Equals(previousGroupValues[level], currentGroupValue))
                            {
                                for (var deeperLevel = level + 1; deeperLevel < previousGroupValues.Length; deeperLevel++)
                                {
                                    hasPreviousGroupValues[deeperLevel] = false;
                                    previousGroupValues[deeperLevel] = null;
                                }
                                var indentCount = Math.Min(level, Math.Max(0, visibleColumns.Count - 1));
                                <tr class="reports-group-row reports-group-row-level-@level">
                                    @for (var indent = 0; indent < indentCount; indent++)
                                    {
                                        <td class="reports-group-indent-cell" aria-hidden="true"></td>
                                    }
                                    <td colspan="@Math.Max(1, visibleColumns.Count - indentCount)">
                                        <span class="reports-group-level">گروه @((level + 1).ToString()) · @groupColumn</span>
                                        <strong>@DisplayCell(row, groupColumn)</strong>
                                    </td>
                                </tr>
                                previousGroupValues[level] = currentGroupValue;
                                hasPreviousGroupValues[level] = true;
                            }
                        }
                        <tr>@foreach (var column in visibleColumns) { <td>@DisplayCell(row, column)</td> }</tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @foreach (var column in Model.AllColumns.Where(column => Model.HiddenColumns.Contains(column, StringComparer.OrdinalIgnoreCase)))
        {
            if (Model.Filters.TryGetValue(column, out var hiddenFilter))
            {
                <input type="hidden" name="filters[@column]" value="@hiddenFilter" />
            }
        }

        @if (Model.Report.NeedsPagination)
        {
            <div class="reports-pagination">
                <span>نمایش @Model.Result.Rows.Count از @Model.TotalRows.ToString("N0") رکورد</span>
                <div>
                    <button type="submit" name="page" value="@(Model.Page - 1)" class="reports-page-button" disabled="@(Model.Page <= 1)">قبلی</button>
                    <strong>@Model.Page / @Model.TotalPages</strong>
                    <button type="submit" name="page" value="@(Model.Page + 1)" class="reports-page-button" disabled="@(Model.Page >= Model.TotalPages)">بعدی</button>
                </div>
            </div>
        }
        else
        {
            <div class="reports-pagination"><span>نمایش تمام @Model.TotalRows.ToString("N0") رکورد</span></div>
        }
    </form>

    <details class="reports-result-details">
        <summary class="reports-result-details-summary">
            <span><strong>جزئیات گزارش و پارامترهای اجرا</strong><small>اطلاعات سرور، دیتابیس و مقادیر پارامترهای این اجرا</small></span>
            <span class="reports-collapse-icon">⌄</span>
        </summary>
        <div class="reports-result-details-content">
        <div class="reports-result-context">
            <div class="reports-result-context-title"><span class="reports-connection-status-dot"></span><strong>محل اجرای گزارش</strong></div>
            <div><small>واحد تجاری</small><strong>@Model.SelectedConnection.VahedetejariDs</strong></div>
            <div><small>سرور</small><bdi>@Model.SelectedConnection.Server</bdi></div>
            <div><small>دیتابیس</small><bdi>@Model.SelectedConnection.DataBAset</bdi></div>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedConnection.ServerIp))
            {
                <div><small>IP سرور</small><bdi>@Model.SelectedConnection.ServerIp</bdi></div>
            }
        </div>
        <div class="reports-parameter-details">
            @if (Model.Values.Count == 0)
            {
                <span class="reports-no-parameters">این گزارش پارامتر ورودی نداشته است.</span>
            }
            else
            {
                @foreach (var item in Model.Values)
                {
                    <div><small>@(Model.Report.Parameters.FirstOrDefault(p => string.Equals(p.Name, item.Key, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? item.Key)</small><strong>@(string.IsNullOrWhiteSpace(item.Value) ? "—" : item.Value)</strong></div>
                }
            }
        </div>
        </div>
    </details>

    <footer class="reports-result-footer"><span>© @DateTime.Now.Year گروه صنعتی مینو</span><span>MINOO WEB REPORTS</span></footer>
</main>
